# Local .terraform directories
**/.terraform/*

# .tfstate files (Contains sensitive data about your infra)
*.tfstate
*.tfstate.*

# Crash log files
crash.log
override.tf
override.tf.json

# Exclude all .tfvars files, which are likely to contain sensitive data,
# such as password, private keys, and other secrets.
*.tfvars
*.tfvars.json
